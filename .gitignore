# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local databases and database backups
*.db
*.db-*
*.backup
*.backup-*
*.sqlite
*.sqlite3

# local SQL dumps and reconciliation files
*.sql

# local AI/editor configuration
/.agents/
/.claude/
/.cursor/
/.devin/

# local project notes and temporary files
student-cookies.txt
my-quizzes-page.txt
check-results.cjs
check-schools.cjs
# migration/export temporary files
sqlite-data-export.json
inspect-db.js
migrate-sqlite-to-supabase.js
# local backup copies
*.backup.ts
*.backup.tsx
prisma/prisma.config.ts
prisma/schema.after-db-pull.backup.prisma
prisma/schema.before-parent-push.backup.prisma
prisma/schema.before-parent-push.prisma
prisma/schema.backup.prisma

.vercel
.env*

# Keep Prisma migration SQL files under version control
!prisma/migrations/**/*.sql

# Preserve archived original SQLite migration SQL files
!prisma/migrations-sqlite-archive-20261022/**/*.sql
